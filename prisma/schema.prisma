generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SiteConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model HeroImage {
  id          Int @id @default(autoincrement())
  link        String?
  url         String
  description String?
  tagline     String?
  order       Int @default(0)
  createdAt   DateTime @default(now())
}

model Product {
  id        Int              @id @default(autoincrement())
  section   String
  title     String
  imageUrl  String?
  order     Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  images    ProductImage[]
  directors ProductDirector[]
}

model ProductImage {
  id          Int     @id @default(autoincrement())
  productId   Int
  url         String
  thumbUrl    String? // 갤러리 썸네일 스트립 전용 작은 파일 (없으면 url로 폴백)
  order       Int     @default(0)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}


model User {
  id               String    @id @default(cuid())
  password         String?
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  firstName        String?
  middleName       String?
  lastName         String?
  birthYear        String?
  birthMonth       String?
  birthDay         String?
  gender           String?
  country          String?
  phoneCountryCode String?
  phone            String?
  termsAgreedAt    DateTime?
  isOnboarded      Boolean   @default(false)
  role             String    @default("user") // "user" | "admin"(리뷰 인라인 관리) | "master"(매거진 작성)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  accounts         Account[]
  sessions         Session[]
  reviews          Review[]
  comments         Comment[]
  notifications    Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Admin {
  id                String     @id @default(cuid())
  loginId           String     @unique
  password          String
  name              String
  role              String     @default("staff")
  phone             String
  isActive          Boolean    @default(true)
  isPasswordChanged Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  auditLogs         AuditLog[]
}

// 어드민이 콘텐츠(Product/Package 등)를 수정할 때 남기는 변경 기록 — 삭제 API를
// 일부러 안 만들어서 앱에서는 지울 수 없음 (실수로 값이 바뀐 걸 나중에 추적하기 위함)
model AuditLog {
  id        Int      @id @default(autoincrement())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id])
  model     String // 예: "Product"
  recordId  String // 대상 레코드 id (문자열로 통일)
  field     String // 예: "title"
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  @@index([model, recordId])
}

model Magazine {
  id        Int             @id @default(autoincrement())
  title     String
  content   String
  imageUrl  String?
  published Boolean         @default(false)
  isPinned  Boolean         @default(false) // 상단 고정 (마스터 수동, "우수" 개념 아님)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  images    MagazineImage[]

  @@index([published, createdAt])
  @@index([isPinned, createdAt])
}

model MagazineImage {
  id         Int      @id @default(autoincrement())
  magazineId Int
  url        String
  order      Int      @default(0)
  magazine   Magazine @relation(fields: [magazineId], references: [id], onDelete: Cascade)

  @@index([magazineId])
}

model Director {
  id        Int               @id @default(autoincrement())
  number    String            // "#1-1", "#1-2", "#2"
  name      String
  location  String?           // "Jeju" | "Seoul" — 상품 연결 여부와 무관하게 항상 유지되는 소속 지역
  instagram String?
  imageUrl  String?
  order     Int               @default(0)
  products  ProductDirector[]
  packages  Package[]
  reviews   Review[]
}

model ProductDirector {
  productId  Int
  directorId Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  director   Director @relation(fields: [directorId], references: [id], onDelete: Cascade)

  @@id([productId, directorId])
}

model Package {
  id              Int                @id @default(autoincrement())
  directorId      Int
  name            String             // "Package A", "Package B", "Package C"
  subtitle        String?
  priceSNS        Int
  priceNoSNS      Int
  isSinglePrice   Boolean            @default(false) // true면 priceSNS/priceNoSNS가 같은 단일 가격 (어드민에서 가격 입력칸 1개만 노출)
  shootingTime    String             // "4 hours"
  shootingTimeDetail String?
  locations       String             // "3 sites"
  locationsDetail String?
  originalPhotos  String             // "800+"
  retouched       Int
  retouchedDetail String?
  thumbnailUrl    String?
  order           Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  director        Director           @relation(fields: [directorId], references: [id], onDelete: Cascade)
  addons          PackageAddon[]
  inclusions      PackageInclusion[]
  partners        PackagePartner[]
  images          PackageImage[]
}

model PackageImage {
  id         Int     @id @default(autoincrement())
  packageId  Int
  webUrl     String  // 압축본 — 갤러리에서 평소 노출
  originalUrl String // 원본 — 클릭 확대 시 노출
  thumbUrl   String? // 갤러리 썸네일 스트립 전용 작은 파일 (없으면 webUrl로 폴백)
  order      Int     @default(0)
  package    Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model Addon {
  id          Int            @id @default(autoincrement())
  name        String         // 내부 식별용 이름 (같은 displayName인데 가격/설명이 다른 버전을 구분하기 위해 접미사가 붙을 수 있음)
  displayName String?        // 화면에 실제로 노출할 이름. null이면 name을 그대로 씀
  price       Int
  desc        String?
  order       Int            @default(0)
  packages    PackageAddon[]
}

model PackageAddon {
  packageId Int
  addonId   Int
  order     Int     @default(0)
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  addon     Addon   @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@id([packageId, addonId])
}

model Inclusion {
  id       Int                @id @default(autoincrement())
  name     String
  order    Int                @default(0)
  packages PackageInclusion[]
}

model PackageInclusion {
  packageId   Int
  inclusionId Int
  order       Int       @default(0)
  package     Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  inclusion   Inclusion @relation(fields: [inclusionId], references: [id], onDelete: Cascade)

  @@id([packageId, inclusionId])
}

model Partner {
  id          Int                @id @default(autoincrement())
  role        String             // "hmu" | "dress" | "suit" | "bouquet"
  name        String             // 내부 식별용 이름 (지역별로 다른 레코드를 구분하기 위해 접미사가 붙을 수 있음, 예: "K Salon (Jeju)")
  displayName String?            // 화면에 실제로 노출할 이름. null이면 name을 그대로 씀
  instagram   String?            // 예전 방식(문자열 하나에 " / "로 합쳐서 저장) — instagramAccounts로 대체 중, 당분간 마이그레이션 안 된 레코드를 위해 남겨둠
  imageUrl    String?
  order       Int                @default(0)
  packages    PackagePartner[]
  instagramAccounts PartnerInstagram[]
}

model PartnerInstagram {
  id        Int     @id @default(autoincrement())
  partnerId Int
  handle    String  // "@why__brush" 형태
  order     Int     @default(0)
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

model PackagePartner {
  packageId Int
  partnerId Int
  order     Int     @default(0)
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([packageId, partnerId])
}

model Review {
  id          Int           @id @default(autoincrement())
  title       String
  content     String
  name        String
  country     String
  shootingDate String
  productType String        // "wedding" | "snap"
  location    String        // "jeju" | "seoul"
  rating      Int?          // 1~5, 참고용 표시
  isFeatured  Boolean       @default(false) // 우수 리뷰 상단 고정 (어드민 수동)
  password    String?       // 비회원 전용
  userId      String?
  directorId  Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  director    Director?     @relation(fields: [directorId], references: [id], onDelete: SetNull)
  images      ReviewImage[]
  comments    Comment[]
  notifications Notification[]

  @@index([productType, location])
  @@index([isFeatured, createdAt])
  @@index([directorId])
  @@index([userId])
}

model ReviewImage {
  id       Int    @id @default(autoincrement())
  reviewId Int
  url      String
  order    Int    @default(0)
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model Comment {
  id         Int        @id @default(autoincrement())
  reviewId   Int
  content    String
  authorName String
  password   String?    // 비회원 전용
  userId     String?
  parentId   Int?
  deletedAt  DateTime?  // soft delete — 채워지면 "삭제된 댓글입니다"로 표시, 답글은 유지
  createdAt  DateTime   @default(now())
  review     Review     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent     Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]  @relation("CommentReplies")
  notifications Notification[]

  @@index([reviewId])
  @@index([parentId])
  @@index([userId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String   // 알림 받는 사람 (회원만)
  type      String   // "comment" | "reply"
  reviewId  Int
  commentId Int?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([reviewId])
  @@index([commentId])
}