generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SiteConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model HeroImage {
  id          Int @id @default(autoincrement())
  link        String?
  url         String
  description String?
  tagline     String?
  order       Int @default(0)
  createdAt   DateTime @default(now())
}

model Product {
  id        Int              @id @default(autoincrement())
  section   String
  title     String
  imageUrl  String?
  order     Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  images    ProductImage[]
  bookmarks Bookmark[]
  directors ProductDirector[]
}

model ProductImage {
  id          Int     @id @default(autoincrement())
  productId   Int
  url         String
  order       Int     @default(0)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}


model User {
  id               String    @id @default(cuid())
  password         String?
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  firstName        String?
  middleName       String?
  lastName         String?
  birthYear        String?
  birthMonth       String?
  birthDay         String?
  gender           String?
  country          String?
  phoneCountryCode String?
  phone            String?
  termsAgreedAt    DateTime?
  isOnboarded      Boolean   @default(false)
  role             String    @default("user") // "user" | "admin"(리뷰 인라인 관리) | "master"(매거진 작성)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  accounts         Account[]
  sessions         Session[]
  bookmarks        Bookmark[]
  reviews          Review[]
  comments         Comment[]
  notifications    Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Admin {
  id                String   @id @default(cuid())
  loginId           String   @unique
  password          String
  name              String
  role              String   @default("staff")
  phone             String
  isActive          Boolean  @default(true)
  isPasswordChanged Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Magazine {
  id        Int             @id @default(autoincrement())
  title     String
  content   String
  imageUrl  String?
  published Boolean         @default(false)
  isPinned  Boolean         @default(false) // 상단 고정 (마스터 수동, "우수" 개념 아님)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  images    MagazineImage[]

  @@index([published, createdAt])
  @@index([isPinned, createdAt])
}

model MagazineImage {
  id         Int      @id @default(autoincrement())
  magazineId Int
  url        String
  order      Int      @default(0)
  magazine   Magazine @relation(fields: [magazineId], references: [id], onDelete: Cascade)

  @@index([magazineId])
}

model Bookmark {
    id        Int      @id @default(autoincrement())                                                                   
    userId    String                                                                                                   
    productId Int                                                                                                      
    createdAt DateTime @default(now())                                                                                 
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)                                
    product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)                             
   
    @@unique([userId, productId])
}

model Director {
  id        Int               @id @default(autoincrement())
  number    String            // "#1-1", "#1-2", "#2"
  name      String
  location  String?           // "Jeju" | "Seoul" — 상품 연결 여부와 무관하게 항상 유지되는 소속 지역
  instagram String?
  imageUrl  String?
  order     Int               @default(0)
  products  ProductDirector[]
  packages  Package[]
  reviews   Review[]
}

model ProductDirector {
  productId  Int
  directorId Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  director   Director @relation(fields: [directorId], references: [id], onDelete: Cascade)

  @@id([productId, directorId])
}

model Package {
  id              Int                @id @default(autoincrement())
  directorId      Int
  name            String             // "Package A", "Package B", "Package C"
  subtitle        String?
  priceSNS        Int
  priceNoSNS      Int
  shootingTime    String             // "4 hours"
  locations       String             // "3 sites"
  originalPhotos  String             // "800+"
  retouched       Int
  retouchedDetail String?
  order           Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  director        Director           @relation(fields: [directorId], references: [id], onDelete: Cascade)
  addons          PackageAddon[]
  inclusions      PackageInclusion[]
  partners        PackagePartner[]
}

model Addon {
  id       Int            @id @default(autoincrement())
  name     String
  price    Int
  desc     String?
  order    Int            @default(0)
  packages PackageAddon[]
}

model PackageAddon {
  packageId Int
  addonId   Int
  order     Int     @default(0)
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  addon     Addon   @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@id([packageId, addonId])
}

model Inclusion {
  id       Int                @id @default(autoincrement())
  name     String
  order    Int                @default(0)
  packages PackageInclusion[]
}

model PackageInclusion {
  packageId   Int
  inclusionId Int
  order       Int       @default(0)
  package     Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  inclusion   Inclusion @relation(fields: [inclusionId], references: [id], onDelete: Cascade)

  @@id([packageId, inclusionId])
}

model Partner {
  id        Int              @id @default(autoincrement())
  role      String           // "hmu" | "dress" | "suit" | "bouquet"
  name      String
  instagram String?
  imageUrl  String?
  order     Int              @default(0)
  packages  PackagePartner[]
}

model PackagePartner {
  packageId Int
  partnerId Int
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([packageId, partnerId])
}

model Review {
  id          Int           @id @default(autoincrement())
  title       String
  content     String
  name        String
  country     String
  shootingDate String
  productType String        // "wedding" | "snap"
  location    String        // "jeju" | "seoul"
  rating      Int?          // 1~5, 참고용 표시
  isFeatured  Boolean       @default(false) // 우수 리뷰 상단 고정 (어드민 수동)
  password    String?       // 비회원 전용
  userId      String?
  directorId  Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  director    Director?     @relation(fields: [directorId], references: [id], onDelete: SetNull)
  images      ReviewImage[]
  comments    Comment[]
  notifications Notification[]

  @@index([productType, location])
  @@index([isFeatured, createdAt])
  @@index([directorId])
  @@index([userId])
}

model ReviewImage {
  id       Int    @id @default(autoincrement())
  reviewId Int
  url      String
  order    Int    @default(0)
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model Comment {
  id         Int        @id @default(autoincrement())
  reviewId   Int
  content    String
  authorName String
  password   String?    // 비회원 전용
  userId     String?
  parentId   Int?
  deletedAt  DateTime?  // soft delete — 채워지면 "삭제된 댓글입니다"로 표시, 답글은 유지
  createdAt  DateTime   @default(now())
  review     Review     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent     Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]  @relation("CommentReplies")
  notifications Notification[]

  @@index([reviewId])
  @@index([parentId])
  @@index([userId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String   // 알림 받는 사람 (회원만)
  type      String   // "comment" | "reply"
  reviewId  Int
  commentId Int?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([reviewId])
  @@index([commentId])
}